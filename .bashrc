export PATH="$HOME/bin:$PATH"
export PATH="$HOME/PHI_CORE/bin:$PATH"
export PYTHONPATH="$HOME/PHI_CORE/lib:$PYTHONPATH"
alias aether='cd ~/AETHER-MASTER/PHI_UNIFIED_ETERNAL'
alias torsion='python ~/AETHER-MASTER/PHI_UNIFIED_ETERNAL/physics/torsion_unifier.py'
alias sensor='python ~/AETHER-MASTER/PHI_UNIFIED_ETERNAL/core/real_sensor_bridge.py'
alias mod='python ~/AETHER-MASTER/PHI_UNIFIED_ETERNAL/core/esqet_modulator.py'
alias agi='cd ~/AETHER-MASTER/PHI_UNIFIED_ETERNAL/core && python seed_agi.py'
